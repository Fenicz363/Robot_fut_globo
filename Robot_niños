"""
Robot Control — FutCar / Globo Smash
Control por Bluetooth (BLE) de un robot ESP32.

Instalar:  pip install customtkinter bleak
Ejecutar:  python robot_control.py
"""
import asyncio
import queue
import threading
import time

import customtkinter as ctk
from bleak import BleakClient, BleakScanner

# ───────────── Configuración (debe coincidir con el Arduino) ─────────────
DEVICE_NAME = "ESP32-Robot-BLE"
CHARACTERISTIC_UUID = "beb5483e-36e1-4688-b7f5-ea07361b26a8"
FIXED_SPEED = 180            # velocidad fija (0-255); se envía una vez al conectar
FUTCAR_CLAMP_SECONDS = 3.0   # tiempo que la pinza se mantiene cerrada (FutCar)
CLAMP_COOLDOWN_MS = 500      # descanso después de abrir (FutCar)
SERVO_MIN, SERVO_MAX, SERVO_HOME = 0, 180, 90

VERSION_FUTCAR = "FutCar"
VERSION_GLOBO = "Globo Smash"

MODE_HELP = {
    VERSION_FUTCAR: "La pinza se cierra sola durante 3 s, se abre y descansa un momento. "
                    "Solo tienes que pulsar el botón.",
    VERSION_GLOBO: "Mantén pulsado el botón para cerrar la pinza; al soltar se abre. "
                   "Ajusta el ángulo del servo con el control de abajo.",
}

C = dict(
    bg="#0d1117", card="#161b22", card_alt="#1c2330", border="#2a3342",
    key="#252e3d", key_hover="#31405a", active="#3b82f6", active_hover="#60a5fa",
    active_text="#7db4ff", text="#e6edf3", muted="#8b96a5",
    ok="#16a34a", warn="#d97706", bad="#dc2626", bad_hover="#ef4444",
    clamp="#7c3aed", clamp_hover="#8b5cf6",
)

# Teclado → comando
KEY_MAP = {'w': 'w', 'up': 'w', 's': 's', 'down': 's',
           'a': 'a', 'left': 'a', 'd': 'd', 'right': 'd'}
DIAG_MAP = {frozenset('wa'): 'q', frozenset('wd'): 'e',
            frozenset('sa'): 'z', frozenset('sd'): 'c'}
NAMES = {'w': 'Adelante', 's': 'Atrás', 'a': 'Izquierda', 'd': 'Derecha',
         'q': 'Adelante-Izquierda', 'e': 'Adelante-Derecha',
         'z': 'Atrás-Izquierda', 'c': 'Atrás-Derecha', 'x': 'Detener'}
PAD_LAYOUT = [('q', '↖', 'W+A'), ('w', '↑', 'W'), ('e', '↗', 'W+D'),
              ('a', '←', 'A'), ('x', '■', 'STOP'), ('d', '→', 'D'),
              ('z', '↙', 'S+A'), ('s', '↓', 'S'), ('c', '↘', 'S+D')]


# ═════════════════════════ Capa Bluetooth ═════════════════════════
class BleLink:
    """Maneja BLE en un hilo propio (un solo event loop para toda la sesión)."""

    def __init__(self, on_error=None):
        self.client = None
        self.on_error = on_error
        self._lock = None
        self.loop = asyncio.new_event_loop()
        threading.Thread(target=self._run, daemon=True).start()

    def _run(self):
        asyncio.set_event_loop(self.loop)
        self.loop.run_forever()

    @property
    def connected(self):
        return self.client is not None and self.client.is_connected

    def submit(self, coro, callback=None):
        fut = asyncio.run_coroutine_threadsafe(coro, self.loop)
        if callback:
            fut.add_done_callback(callback)
        return fut

    async def connect(self, on_lost):
        device = await BleakScanner.find_device_by_name(DEVICE_NAME, timeout=10.0)
        if device is None:
            raise RuntimeError(f"No encontré «{DEVICE_NAME}». ¿Está encendido y cerca?")
        self.client = BleakClient(device, disconnected_callback=lambda _c: on_lost())
        await self.client.connect()
        return device

    async def disconnect(self):
        if self.connected:
            try:
                await self.write("x")          # parar antes de desconectar
            except Exception:
                pass
            await self.client.disconnect()

    async def write(self, text):
        if self._lock is None:
            self._lock = asyncio.Lock()        # escrituras en orden, una a la vez
        async with self._lock:
            if self.connected:
                await self.client.write_gatt_char(CHARACTERISTIC_UUID, text.encode())

    def send(self, text):
        if not self.connected:
            return
        fut = self.submit(self.write(text))
        fut.add_done_callback(lambda f: self._report(f, text))

    def _report(self, fut, text):
        if not fut.cancelled() and fut.exception() and self.on_error:
            self.on_error(f"⚠ No se pudo enviar «{text}»: {fut.exception()}")


# ═════════════════════════ Interfaz ═════════════════════════
class RobotApp(ctk.CTk):
    def __init__(self):
        super().__init__()
        self.title("Robot Control — FutCar / Globo Smash")
        self.geometry("960x740")
        self.minsize(940, 700)
        self.configure(fg_color=C["bg"])

        # Estado
        self.ui_queue = queue.Queue()
        self.link = BleLink(on_error=lambda m: self.ui(self.log, m))
        self.connected = False
        self.mode = VERSION_FUTCAR
        self.active_keys = set()
        self.mouse_cmd = None
        self.last_cmd = None
        self.clamp_busy = False
        self.clamp_held = False
        self.clamp_end = 0.0
        self.clamp_job = None
        self.servo_target = SERVO_HOME
        self.servo_sent = None
        self.servo_job = None

        self.f_bold = ctk.CTkFont(size=13, weight="bold")
        self.f_small = ctk.CTkFont(size=11, weight="bold")

        self.grid_columnconfigure(1, weight=1)
        self.grid_rowconfigure(1, weight=1)
        self._build_header()
        self._build_drive()
        self._build_side()
        self._build_log()
        self._build_footer()

        self.bind("<KeyPress>", self.on_key_press)
        self.bind("<KeyRelease>", self.on_key_release)
        self.bind("<FocusOut>", self.on_focus_out)
        self.protocol("WM_DELETE_WINDOW", self.on_close)

        self.apply_mode()
        self.set_connection("disconnected")
        self.log("Listo. Enciende el robot y pulsa «Conectar».")
        self._poll_id = self.after(40, self._poll_ui)
        self.focus_force()

    # ───────── helpers de UI ─────────
    def card(self, parent):
        return ctk.CTkFrame(parent, fg_color=C["card"], corner_radius=16,
                            border_width=1, border_color=C["border"])

    def section(self, parent, text):
        ctk.CTkLabel(parent, text=text, font=self.f_small,
                     text_color=C["muted"]).pack(anchor="w", padx=20, pady=(16, 6))

    def ui(self, fn, *args):
        """Llamar desde otros hilos: ejecuta fn en el hilo de la interfaz."""
        self.ui_queue.put((fn, args))

    def _poll_ui(self):
        while True:
            try:
                fn, args = self.ui_queue.get_nowait()
            except queue.Empty:
                break
            fn(*args)
        self._poll_id = self.after(40, self._poll_ui)

    def log(self, msg):
        box = self.log_box
        box.configure(state="normal")
        box.insert("end", f"{time.strftime('%H:%M:%S')}  {msg}\n")
        if int(box.index("end-1c").split(".")[0]) > 80:
            box.delete("1.0", "2.0")
        box.see("end")
        box.configure(state="disabled")

    # ───────── construcción ─────────
    def _build_header(self):
        h = ctk.CTkFrame(self, fg_color="transparent")
        h.grid(row=0, column=0, columnspan=2, sticky="ew", padx=16, pady=(16, 4))
        left = ctk.CTkFrame(h, fg_color="transparent")
        left.pack(side="left")
        ctk.CTkLabel(left, text="Robot Control", text_color=C["text"],
                     font=ctk.CTkFont(size=26, weight="bold")).pack(anchor="w")
        ctk.CTkLabel(left, text="FutCar · Globo Smash  |  Bluetooth BLE",
                     text_color=C["muted"]).pack(anchor="w")

        self.connect_btn = ctk.CTkButton(h, width=150, height=42, corner_radius=12,
                                         font=self.f_bold, command=self.on_connect_click)
        self.connect_btn.pack(side="right")
        pill = ctk.CTkFrame(h, fg_color=C["card"], corner_radius=20,
                            border_width=1, border_color=C["border"])
        pill.pack(side="right", padx=12)
        self.dot = ctk.CTkLabel(pill, text="●", font=ctk.CTkFont(size=16))
        self.dot.pack(side="left", padx=(14, 4), pady=8)
        self.status_lbl = ctk.CTkLabel(pill, text="", text_color=C["text"])
        self.status_lbl.pack(side="left", padx=(0, 16))

    def _build_drive(self):
        d = self.card(self)
        d.grid(row=1, column=0, sticky="ns", padx=(16, 8), pady=8)
        self.section(d, "MOVIMIENTO")
        grid = ctk.CTkFrame(d, fg_color="transparent")
        grid.pack(padx=16, pady=2)
        self.pad_btns = {}
        for i, (cmd, arrow, hint) in enumerate(PAD_LAYOUT):
            stop = cmd == 'x'
            b = ctk.CTkButton(grid, text=f"{arrow}\n{hint}", width=98, height=86,
                              corner_radius=14, font=ctk.CTkFont(size=17, weight="bold"),
                              fg_color=C["bad"] if stop else C["key"],
                              hover_color=C["bad_hover"] if stop else C["key_hover"],
                              state="disabled")
            b.grid(row=i // 3, column=i % 3, padx=5, pady=5)
            b.bind("<ButtonPress-1>", lambda e, c=cmd: self.pad_press(c))
            b.bind("<ButtonRelease-1>", lambda e: self.pad_release())
            self.pad_btns[cmd] = b
        chip = ctk.CTkFrame(d, fg_color=C["card_alt"], corner_radius=10)
        chip.pack(fill="x", padx=21, pady=(10, 18))
        ctk.CTkLabel(chip, text="Estado:", text_color=C["muted"]).pack(side="left", padx=(14, 6), pady=10)
        self.motion_lbl = ctk.CTkLabel(chip, text="Detenido", font=self.f_bold, text_color=C["muted"])
        self.motion_lbl.pack(side="left")

    def _build_side(self):
        side = ctk.CTkFrame(self, fg_color="transparent")
        side.grid(row=1, column=1, sticky="nsew", padx=(8, 16), pady=8)

        # Versión
        m = self.card(side)
        m.pack(fill="x", pady=(0, 12))
        self.section(m, "VERSIÓN DEL ROBOT")
        self.mode_seg = ctk.CTkSegmentedButton(
            m, values=[VERSION_FUTCAR, VERSION_GLOBO], command=self.on_mode_change, height=38,
            selected_color=C["active"], selected_hover_color=C["active_hover"],
            unselected_color=C["key"], unselected_hover_color=C["key_hover"], font=self.f_bold)
        self.mode_seg.set(self.mode)
        self.mode_seg.pack(fill="x", padx=20)
        self.mode_desc = ctk.CTkLabel(m, text="", wraplength=470, justify="left", text_color=C["muted"])
        self.mode_desc.pack(anchor="w", padx=20, pady=(10, 16))

        # Pinza
        c = self.card(side)
        c.pack(fill="both", expand=True)
        self.section(c, "PINZA")
        self.clamp_btn = ctk.CTkButton(c, text="", height=76, corner_radius=14,
                                       font=ctk.CTkFont(size=17, weight="bold"), state="disabled")
        self.clamp_btn.pack(fill="x", padx=20)
        self.clamp_btn.bind("<ButtonPress-1>", lambda e: self.clamp_press())
        self.clamp_btn.bind("<ButtonRelease-1>", lambda e: self.clamp_release())
        self.extra = ctk.CTkFrame(c, fg_color="transparent")
        self.extra.pack(fill="x")

        # Panel FutCar: barra de tiempo
        self.futcar_panel = ctk.CTkFrame(self.extra, fg_color="transparent")
        self.clamp_progress = ctk.CTkProgressBar(self.futcar_panel, height=12, progress_color=C["clamp_hover"])
        self.clamp_progress.set(0)
        self.clamp_progress.pack(fill="x", pady=(2, 8))
        self.clamp_status = ctk.CTkLabel(self.futcar_panel, text="Lista para cerrar", text_color=C["muted"])
        self.clamp_status.pack()

        # Panel Globo Smash: servo
        g = self.globo_panel = ctk.CTkFrame(self.extra, fg_color="transparent")
        top = ctk.CTkFrame(g, fg_color="transparent")
        top.pack(fill="x")
        ctk.CTkLabel(top, text="Ángulo del servo", text_color=C["muted"]).pack(side="left")
        self.servo_lbl = ctk.CTkLabel(top, text=f"{SERVO_HOME}°", text_color=C["text"],
                                      font=ctk.CTkFont(size=22, weight="bold"))
        self.servo_lbl.pack(side="right")
        self.servo_slider = ctk.CTkSlider(
            g, from_=SERVO_MIN, to=SERVO_MAX, number_of_steps=SERVO_MAX - SERVO_MIN,
            command=lambda v: self.set_servo(v, from_slider=True),
            progress_color=C["clamp"], button_color=C["clamp_hover"], state="disabled")
        self.servo_slider.set(SERVO_HOME)
        self.servo_slider.pack(fill="x", pady=8)
        row = ctk.CTkFrame(g, fg_color="transparent")
        row.pack(pady=(4, 0))
        self.servo_btns = []
        for label, fn in [("−5", lambda: self.set_servo(self.servo_target - 5)),
                          *[(f"{a}°", lambda a=a: self.set_servo(a)) for a in (0, 45, 90, 135, 180)],
                          ("+5", lambda: self.set_servo(self.servo_target + 5))]:
            b = ctk.CTkButton(row, text=label, width=58, height=34, corner_radius=8, command=fn,
                              fg_color=C["key"], hover_color=C["key_hover"], state="disabled")
            b.pack(side="left", padx=3)
            self.servo_btns.append(b)

    def _build_log(self):
        lg = self.card(self)
        lg.grid(row=2, column=0, columnspan=2, sticky="ew", padx=16, pady=8)
        self.section(lg, "REGISTRO DE COMANDOS")
        self.log_box = ctk.CTkTextbox(lg, height=92, fg_color=C["card_alt"], text_color=C["muted"],
                                      corner_radius=10, font=ctk.CTkFont(family="Consolas", size=12),
                                      state="disabled")
        self.log_box.pack(fill="x", padx=20, pady=(0, 16))

    def _build_footer(self):
        f = ctk.CTkFrame(self, fg_color="transparent")
        f.grid(row=3, column=0, columnspan=2, sticky="w", padx=16, pady=(0, 16))
        for key, txt in [("W A S D  /  ← ↑ ↓ →", "mover"), ("Espacio", "pinza"), ("Esc  /  X", "parar")]:
            chip = ctk.CTkFrame(f, fg_color=C["card"], corner_radius=8)
            chip.pack(side="left", padx=(0, 8))
            ctk.CTkLabel(chip, text=key, font=self.f_small, text_color=C["text"]).pack(side="left", padx=(10, 6), pady=5)
            ctk.CTkLabel(chip, text=txt, font=ctk.CTkFont(size=11), text_color=C["muted"]).pack(side="left", padx=(0, 10))

    # ───────── conexión ─────────
    def on_connect_click(self):
        if self.connected:
            self.link.submit(self.link.disconnect())
            return
        self.set_connection("connecting")

        async def job():
            device = await self.link.connect(lambda: self.ui(self.set_connection, "disconnected", "Conexión cerrada"))
            await self.link.write(f"v{FIXED_SPEED:03d}")
            await self.link.write(f"g{SERVO_HOME:03d}")
            return device

        self.link.submit(job(), self._on_connect_done)

    def _on_connect_done(self, fut):          # corre en el hilo BLE
        try:
            device = fut.result()
        except Exception as e:
            self.ui(self.set_connection, "error", str(e) or type(e).__name__)
            return
        self.ui(self.set_connection, "connected", device.name or DEVICE_NAME)

    def set_connection(self, state, detail=""):
        self.connected = state == "connected"
        dot, text, btn, fg, hover = {
            "disconnected": (C["muted"], detail or "Desconectado", "Conectar", C["active"], C["active_hover"]),
            "connecting": (C["warn"], "Buscando robot…", "Conectando…", C["key"], C["key"]),
            "connected": (C["ok"], f"Conectado · {detail}", "Desconectar", C["bad"], C["bad_hover"]),
            "error": (C["bad"], detail[:55], "Reintentar", C["active"], C["active_hover"]),
        }[state]
        self.dot.configure(text_color=dot)
        self.status_lbl.configure(text=text)
        self.connect_btn.configure(text=btn, fg_color=fg, hover_color=hover,
                                   state="disabled" if state == "connecting" else "normal")
        if state in ("error", "disconnected") and detail:
            self.log(detail)
        if self.connected:
            self.log(f"Conectado. Velocidad fija {FIXED_SPEED}, servo en {SERVO_HOME}°.")
            self.servo_sent = SERVO_HOME
            self.set_servo(SERVO_HOME)
        else:
            self.active_keys.clear()
            self.mouse_cmd = self.last_cmd = None
            self.highlight(None)
            self.reset_clamp()
        self.enable_controls(self.connected)

    def enable_controls(self, on):
        st = "normal" if on else "disabled"
        for b in (*self.pad_btns.values(), self.clamp_btn, self.servo_slider, *self.servo_btns):
            b.configure(state=st)

    # ───────── movimiento ─────────
    def tx(self, cmd, label=""):
        self.link.send(cmd)
        self.log(f"→ {cmd}   {label}")

    def keyboard_direction(self):
        vert = 'w' if 'w' in self.active_keys else ('s' if 's' in self.active_keys else None)
        horiz = 'a' if 'a' in self.active_keys else ('d' if 'd' in self.active_keys else None)
        if vert and horiz:
            return DIAG_MAP[frozenset((vert, horiz))]
        return vert or horiz

    def update_motion(self):
        cmd = self.mouse_cmd or self.keyboard_direction()
        if cmd == self.last_cmd:
            return
        self.last_cmd = cmd
        self.tx(cmd or 'x', NAMES[cmd or 'x'])
        self.highlight(cmd)

    def stop_all(self, reason="Detener"):
        self.active_keys.clear()
        self.mouse_cmd = self.last_cmd = None
        self.tx('x', reason)
        self.highlight(None)

    def highlight(self, cmd):
        for key, b in self.pad_btns.items():
            if key != 'x':
                on = key == cmd
                b.configure(fg_color=C["active"] if on else C["key"],
                            hover_color=C["active"] if on else C["key_hover"])
        if cmd:
            self.motion_lbl.configure(text=NAMES[cmd], text_color=C["active_text"])
        else:
            self.motion_lbl.configure(text="Detenido", text_color=C["muted"])

    def pad_press(self, cmd):
        if not self.connected:
            return
        if cmd == 'x':
            self.stop_all("Botón STOP")
        else:
            self.mouse_cmd = cmd
            self.update_motion()

    def pad_release(self):
        if self.mouse_cmd:
            self.mouse_cmd = None
            self.update_motion()

    # ───────── teclado ─────────
    def on_key_press(self, e):
        if not self.connected:
            return
        k = e.keysym.lower()
        if k in KEY_MAP:
            self.active_keys.add(KEY_MAP[k])
            self.update_motion()
        elif k == 'space':
            self.clamp_press()
        elif k in ('escape', 'x'):
            self.stop_all("Parada de emergencia")

    def on_key_release(self, e):
        if not self.connected:
            return
        k = e.keysym.lower()
        if k in KEY_MAP:
            self.active_keys.discard(KEY_MAP[k])
            self.update_motion()
        elif k == 'space':
            self.clamp_release()

    def on_focus_out(self, e):
        if e.widget is self:
            self.after(80, self._check_focus)

    def _check_focus(self):
        """Si la ventana pierde el foco con una tecla pulsada, el robot se detiene."""
        try:
            lost = self.focus_displayof() is None
        except Exception:
            return
        if lost and self.connected:
            self.active_keys.clear()
            self.mouse_cmd = None
            if self.last_cmd:
                self.stop_all("Ventana sin foco")
            self.clamp_release()

    # ───────── versión ─────────
    def on_mode_change(self, choice):
        self.mode = choice
        if self.connected:
            self.tx('o', "Abrir pinza (cambio de versión)")
        self.reset_clamp()
        self.apply_mode()

    def apply_mode(self):
        self.mode_desc.configure(text=MODE_HELP[self.mode])
        self.futcar_panel.pack_forget()
        self.globo_panel.pack_forget()
        panel = self.futcar_panel if self.mode == VERSION_FUTCAR else self.globo_panel
        panel.pack(fill="x", padx=20, pady=(10, 16))

    # ───────── pinza ─────────
    def set_clamp_button(self, state, left=0.0):
        futcar = self.mode == VERSION_FUTCAR
        text, fg, hover = {
            "idle": (f"CERRAR PINZA\nEspacio · se abre en {FUTCAR_CLAMP_SECONDS:g} s" if futcar
                     else "MANTÉN PARA CERRAR\nEspacio (mantener pulsado)", C["clamp"], C["clamp_hover"]),
            "busy": (f"PINZA CERRADA · {left:.1f} s", C["warn"], C["warn"]),
            "held": ("PINZA CERRADA\nSuelta para abrir", C["ok"], C["ok"]),
            "opening": ("ABRIENDO…", C["key"], C["key"]),
        }[state]
        self.clamp_btn.configure(text=text, fg_color=fg, hover_color=hover)

    def clamp_close_cmd(self):
        self.tx('p', "Cerrar pinza")
        self.tx('x', "Parar motores (seguridad)")
        self.last_cmd = None
        self.highlight(None)

    def clamp_press(self):
        if not self.connected:
            return
        if self.mode == VERSION_FUTCAR:
            if not self.clamp_busy:
                self.clamp_busy = True
                self.clamp_end = time.monotonic() + FUTCAR_CLAMP_SECONDS
                self.clamp_close_cmd()
                self.tick_clamp()
        elif not self.clamp_held:
            self.clamp_held = True
            self.clamp_close_cmd()
            self.set_clamp_button("held")

    def clamp_release(self):
        if self.mode == VERSION_GLOBO and self.clamp_held:
            self.clamp_held = False
            self.tx('o', "Abrir pinza")
            self.set_clamp_button("idle")

    def tick_clamp(self):
        left = self.clamp_end - time.monotonic()
        if left <= 0:
            self.tx('o', "Abrir pinza")
            self.clamp_progress.set(0)
            self.clamp_status.configure(text="Abriendo…")
            self.set_clamp_button("opening")
            self.clamp_job = self.after(CLAMP_COOLDOWN_MS, self.reset_clamp)
            return
        self.clamp_progress.set(left / FUTCAR_CLAMP_SECONDS)
        self.clamp_status.configure(text=f"Cerrada — se abre en {left:.1f} s")
        self.set_clamp_button("busy", left)
        self.clamp_job = self.after(50, self.tick_clamp)

    def reset_clamp(self):
        if self.clamp_job is not None:
            self.after_cancel(self.clamp_job)
            self.clamp_job = None
        self.clamp_busy = self.clamp_held = False
        self.clamp_progress.set(0)
        self.clamp_status.configure(text="Lista para cerrar")
        self.set_clamp_button("idle")

    # ───────── servo (Globo Smash) ─────────
    def set_servo(self, angle, from_slider=False):
        angle = max(SERVO_MIN, min(SERVO_MAX, int(angle)))
        self.servo_target = angle
        self.servo_lbl.configure(text=f"{angle}°")
        if not from_slider:
            self.servo_slider.set(angle)
        if self.connected and self.mode == VERSION_GLOBO and self.servo_job is None:
            self.servo_job = self.after(60, self._flush_servo)    # limita el envío por BLE

    def _flush_servo(self):
        self.servo_job = None
        if self.connected and self.servo_target != self.servo_sent:
            self.servo_sent = self.servo_target
            self.link.send(f"g{self.servo_target:03d}")

    # ───────── cierre ─────────
    def on_close(self):
        try:
            if self.link.connected:
                self.link.submit(self.link.disconnect()).result(timeout=2)
        except Exception:
            pass
        self.after_cancel(self._poll_id)
        self.destroy()


